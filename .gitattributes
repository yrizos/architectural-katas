# Auto-detect text files and normalize line endings
* text=auto

# Explicit text files
*.md          text diff=markdown
*.yaml        text
*.html        text
*.toml        text
Makefile      text

# Binary files
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.webp        binary
*.pdf         binary
*.zip         binary
*.gz          binary
*.tar         binary
*.exe         binary
*.dll         binary
*.so          binary
*.dylib       binary

# Exclude repo scaffolding from archives
.gitattributes export-ignore
.gitignore    export-ignore
Makefile      export-ignore
